# Docker Compose project name
COMPOSE_PROJECT_NAME=telemetry-storage-service

# ==============================
# Kafka consumers
# ==============================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

KAFKA_TOPIC_TELEMETRY_CLEAN=telemetry.clean
KAFKA_TOPIC_TELEMETRY_EXPIRED=telemetry.expired

# ===============================
# PostgreSQL + TimescaleDB
# ===============================
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ==============================
# FastAPI
# ==============================

# HTTP port for FastAPI container
HTTP_PORT=2100

# Application settings
APP_NAME=telemetry-storage-service
APP_VERSION=0.1.0
DEBUG=False
API_PREFIX=/api
